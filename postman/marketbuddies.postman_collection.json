  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Cadastro de cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('signupEmail', 'spbiel18+postman' + pm.variables.replaceIn('{{$timestamp}}') + '@gmail.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Usuário criado como CUSTOMER', function () {",
                  "    pm.expect(body.id).to.be.a('number');",
                  "    pm.expect(body.email).to.eql(pm.variables.get('signupEmail'));",
                  "    pm.expect(body.role).to.eql('CUSTOMER');",
                  "});",
                  "",
                  "pm.test('Senha não volta na resposta', function () {",
                  "    pm.expect(body).to.not.have.property('password');",
                  "});",
                  "",
                  "pm.test('Header Location', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Cadastro público: cria sempre um CUSTOMER e devolve 201 sem a senha. O e-mail é gerado a cada execução, então dá para rodar várias vezes.",
            "url": {
              "raw": "{{api}}/api/auth/signup",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Cliente Postman\",\n  \"email\": \"{{signupEmail}}\",\n  \"password\": \"senha123\",\n  \"confirmPassword\": \"senha123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cadastro com e-mail duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Corpo de erro padrão', function () {",
                  "    pm.expect(body.status).to.eql(409);",
                  "    pm.expect(body.message).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('Erro no campo email', function () {",
                  "    pm.expect(body.errors.email).to.eql('Já existe uma conta com esse e-mail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "O e-mail do cliente de teste já existe: 409 com o erro no campo email.",
            "url": {
              "raw": "{{api}}/api/auth/signup",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ana Souza\",\n  \"email\": \"cliente@marketbuddies.com\",\n  \"password\": \"cliente123\",\n  \"confirmPassword\": \"cliente123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login (cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Token Bearer emitido', function () {",
                  "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.tokenType).to.eql('Bearer');",
                  "});",
