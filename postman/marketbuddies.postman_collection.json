            "description": "Senha errada: 401. Print P2 do README.",
            "url": {
              "raw": "{{api}}/api/auth/login",
              "host": [
                "{{api}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@marketbuddies.com\",\n  \"password\": \"senha-errada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('É o cliente de teste', function () {",
                  "    pm.expect(body.email).to.eql('cliente@marketbuddies.com');",
                  "    pm.expect(body.role).to.eql('CUSTOMER');",
                  "    pm.expect(body).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
