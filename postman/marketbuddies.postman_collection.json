    {
      "name": "3. Compras",
      "item": [
        {
          "name": "Compra aprovada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Pedido nasce AWAITING_PAYMENT', function () {",
