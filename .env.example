# MarketBuddies — modelo de variáveis de ambiente.
# Copie para .env (ignorado pelo git) e preencha os segredos.
# O Spring Boot não lê .env sozinho. Na IntelliJ: plugin EnvFile ou
# Run Configuration > Environment variables. No terminal: set -a; source .env; set +a
# Sem .env, cada serviço sobe com os padrões locais do docker-compose.yml.

# --- marketbuddies-api ---
DB_URL=jdbc:postgresql://localhost:5432/marketbuddies
DB_USER=marketbuddies
DB_PASSWORD=marketbuddies
DDL_AUTO=update
SHOW_SQL=false

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Gmail que envia as confirmações: exige verificação em duas etapas e uma senha de app
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=senha-de-app-do-gmail

# Conta ADMIN criada na primeira subida
ADMIN_EMAIL=admin@marketbuddies.com
ADMIN_PASSWORD=troque-esta-senha

# Chave do JWT (HS256): 32 caracteres ou mais
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-ou-mais-caracteres

# --- marketbuddies-worker (usa as mesmas RABBITMQ_*) ---
TRANQUILO_BANK_URL=http://localhost:8090

# PORT fica de fora de propósito: cada serviço tem a sua porta padrão
# (api 8080, tranquilo-bank 8090). No Railway, PORT é definida em cada serviço.
